# Copier en .env sur le VPS puis remplir (voir DEPLOY.md, étape 2).
# Ne JAMAIS versionner le vrai fichier .env.

# Jeton exigé dans l'en-tête x-ncaa-key. Se génère avec : openssl rand -hex 32
NCAA_HEADER_KEY=

# Image du relais. Pour le premier test : henrygd/ncaa-api:latest.
# Une fois le test réussi, la remplacer par l'empreinte exacte (DEPLOY.md, étape 6).
NCAA_API_IMAGE=henrygd/ncaa-api:latest
