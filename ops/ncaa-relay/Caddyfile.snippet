# Bloc à ajouter à la fin de /etc/caddy/Caddyfile (voir DEPLOY.md, étape 5).
# Caddy obtient et renouvelle seul le certificat HTTPS de ncaa.thefrontrow.fr.
# L'accès aux données est protégé par le jeton x-ncaa-key, vérifié par le relais.

ncaa.thefrontrow.fr {
	encode zstd gzip

	# HTTPS obligatoire pendant un an pour ce sous-domaine
	header Strict-Transport-Security "max-age=31536000"

	# Seulement les trois sortes de données que lit le site. La page de
	# documentation du relais et son proxy de logos ne servent à rien ici : ils
	# répondraient sans jeton, donc on ne les expose pas.
	@data path /stats/* /scoreboard/* /game/*
	handle @data {
		reverse_proxy 127.0.0.1:3011
	}
	handle {
		respond 404
	}
}
