# Copy this file to .env.local for local dev (vercel dev), and set the
# same names as Environment Variables in the Vercel project dashboard for
# production/preview deployments. Nothing here is a real secret — fill in
# your own values, never commit .env.local.

# --- TikTok Developer app (developers.tiktok.com) -------------------------
# Client key/secret from your app's "Login Kit" and "Content Posting API"
# products. Sandbox and production apps each have their own key/secret.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Must exactly match a Redirect URI registered on the app (Login Kit ->
# Redirect URI). Requirements from TikTok: absolute, https, no query
# string, no #fragment, max 512 chars.
#   Production example: https://thefrontrow.fr/api/tiktok/auth/callback
#   Local dev with `vercel dev` on port 3000:
#     https://localhost:3000/api/tiktok/auth/callback
#   (TikTok also accepts http://localhost/127.0.0.1 redirect URIs for
#   local testing — check your app's Redirect URI rules in the dashboard.)
TIKTOK_REDIRECT_URI=

# --- Session + token encryption --------------------------------------------
# Signs the anonymous per-browser session cookie (there's no user login in
# FrontRow, so this is what ties a browser to its TikTok connection).
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# Encrypts TikTok access/refresh tokens at rest in Redis (AES-256-GCM).
# Must decode to exactly 32 bytes. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- Upstash Redis (Vercel Marketplace -> Upstash -> create a database) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
